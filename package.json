{
  "name": "@my-monorepo/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "showBackend": "npx nx show project @my-monorepo/backend",
    "showFrontend": "npx nx show project @my-monorepo/frontend",
    "local": "npm --prefix apps/backend run start",
    "dev": "npx nx run-many --projects=backend,frontend --targets=dev --parallel",
    "dev:backend": "npx nx dev backend",
    "dev:frontend": "npx nx dev frontend",
    "build": "npx nx run-many --projects=backend,frontend --targets=build --parallel",
    "build:backend": "npx nx build backend",
    "build:frontend": "npx nx build frontend",
    "start": "npx nx serve backend --configuration=production",
    "start:backend": "npx nx serve backend --configuration=production",
    "start:frontend": "npx nx serve frontend --configuration=production",
    "test": "npx nx run-many --projects=backend,frontend --targets=test",
    "test:backend": "npx nx test backend",
    "test:frontend": "npx nx test frontend",
    "test:e2e": "npx nx run-many --projects=backend-e2e,frontend-e2e --targets=e2e",
    "test:e2e:backend": "npx nx e2e backend-e2e",
    "test:e2e:frontend": "npx nx e2e frontend-e2e",
    "lint": "npx nx run-many --projects=backend,frontend,@my-monorepo/shared-utils --targets=lint --parallel",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,scss,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,scss,css}\"",
    "typecheck": "npx nx run-many --projects=backend,frontend,@my-monorepo/shared-utils --targets=typecheck --parallel",
    "graph": "npx nx graph",
    "affected:build": "npx nx affected:build",
    "affected:test": "npx nx affected:test",
    "affected:lint": "npx nx affected:lint",
    "prepare": "husky"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/devkit": "22.6.5",
    "@nx/eslint": "22.6.5",
    "@nx/eslint-plugin": "22.6.5",
    "@nx/jest": "22.6.5",
    "@nx/js": "22.6.5",
    "@nx/nest": "^22.6.5",
    "@nx/next": "^22.6.5",
    "@nx/node": "22.6.5",
    "@nx/playwright": "22.6.5",
    "@nx/web": "22.6.5",
    "@nx/webpack": "22.6.5",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "~0.2.38",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "babel-jest": "^30.0.2",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "jsonc-eslint-parser": "^2.1.0",
    "nodemon": "^3.1.14",
    "nx": "22.6.5",
    "prettier": "~3.6.2",
    "sass": "1.62.1",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "mongoose": "^8.0.0",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  }
}
